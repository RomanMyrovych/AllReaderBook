<Window x:Class="BookHub.Reader.Views.ReaderMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BookHub.Core.Models;assembly=BookHub.Core"
        xmlns:services="clr-namespace:BookHub.Core.Services;assembly=BookHub.Core"
        xmlns:vm="clr-namespace:BookHub.Reader.ViewModels"
        Title="{Binding ActiveTab.Book.Title, TargetNullValue='AllReaderBook — Надшвидкий автономний рідер (Public Beta)', FallbackValue='AllReaderBook — Надшвидкий автономний рідер (Public Beta)', StringFormat='{}{0} — AllReaderBook — Надшвидкий автономний рідер (Public Beta)'}"
        Icon="pack://application:,,,/AllReaderBook.ico"
        Width="1360" Height="880"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable tabs and fixed reader controls -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5"
                Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LeftTabOverflowButton"
                            Grid.Column="0"
                            Style="{StaticResource ModernButtonStyle}"
                            Content="◀ 0"
                            ToolTip="{DynamicResource Loc_TabScrollLeftTooltip}"
                            Height="30"
                            MinWidth="48"
                            Padding="7,0"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            FontWeight="SemiBold"
                            Click="LeftTabOverflowButton_Click" />
                    <ScrollViewer x:Name="TabStripScrollViewer"
                                  Grid.Column="1"
                                  ClipToBounds="True"
                                  CanContentScroll="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  ScrollChanged="TabStripScrollViewer_ScrollChanged"
                                  SizeChanged="TabStripScrollViewer_SizeChanged"
                                  PreviewMouseWheel="TabStripScrollViewer_PreviewMouseWheel">
                        <ListBox x:Name="TabListBox"
                                 ItemsSource="{Binding OpenTabs}"
                                 SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 Margin="0"
                                 SelectionMode="Single">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter Margin="0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,5,0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Focusable" Value="True" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <EventSetter Event="RequestBringIntoView" Handler="TabListBoxItem_RequestBringIntoView" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5"
                                            Padding="8,2"
                                            Margin="0"
                                            Height="30"
                                            Cursor="Hand"
                                            TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                            MouseLeftButtonDown="TabItemBorder_MouseLeftButtonDown"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{Binding PinMenuHeader}"
                                                          Command="{Binding PlacementTarget.Tag.TogglePinTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator Style="{StaticResource ThemedMenuSeparatorStyle}" />
                                                <MenuItem Header="{DynamicResource Loc_CloseThisTab}"
                                                          InputGestureText="Ctrl+W"
                                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{DynamicResource Loc_CloseOtherTabs}"
                                                          Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{DynamicResource Loc_CloseAllTabs}"
                                                          Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📌"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,5,0"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TabTitle}"
                                                       ToolTip="{Binding Book.FilePath}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="×"
                                                    Width="20"
                                                    Height="24"
                                                    Padding="0"
                                                    FontSize="15"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Background" Value="#28000000" />
                                                                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <Button x:Name="RightTabOverflowButton"
                            Grid.Column="2"
                            Style="{StaticResource ModernButtonStyle}"
                            Content="0 ▶"
                            ToolTip="{DynamicResource Loc_TabScrollRightTooltip}"
                            Height="30"
                            MinWidth="48"
                            Padding="7,0"
                            Margin="4,0,0,0"
                            Visibility="Collapsed"
                            FontWeight="SemiBold"
                            Click="RightTabOverflowButton_Click" />
                    <Button Grid.Column="3"
                            Style="{StaticResource ModernButtonStyle}"
                            Content="+"
                            ToolTip="{DynamicResource Loc_OpenNewTabTooltip}"
                            Command="{Binding OpenAnotherFileInTabCommand}"
                            Width="32"
                            Height="30"
                            Padding="0"
                            Margin="4,0,0,0" />
                </Grid>

                <!-- Right: View Modes Dropdown (Default: Continuous), Settings Icon & About -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ViewModePresets}"
                              SelectedItem="{Binding SelectedViewModePreset, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              MinWidth="140"
                              Height="30"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              ToolTip="{DynamicResource Loc_ReaderContinuousTooltip}" />

                    <Button Style="{StaticResource ModernButtonStyle}"
                            Content="⚙"
                            ToolTip="{DynamicResource Loc_ReaderSettingsTooltip}"
                            Click="OpenSettingsWindowButton_Click"
                            Width="34"
                            Height="30"
                            Padding="0"
                            FontSize="15"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Content="{DynamicResource Loc_ReaderAboutBtn}"
                            ToolTip="{DynamicResource Loc_ReaderAboutTooltip}"
                            Click="OpenAboutWindowButton_Click"
                            Padding="8,2"
                            Height="30" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Flexible Non-Overlapping Reader Toolbar (3 Clear Zones) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Height="44" Margin="8,4"
                  Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Ліва зона (Auto): Кнопка лівої панелі Змісту + Роздільник + Навігація сторінками + Масштаб -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ModernToggleButtonStyle}"
                                  Content="{DynamicResource Loc_ReaderTocBtn}"
                                  IsChecked="{Binding IsTocVisible, Mode=TwoWay}"
                                  ToolTip="{DynamicResource Loc_ReaderTocTooltip}"
                                  Margin="0,0,2,0"
                                  Padding="10,4" />

                    <Separator Margin="6,4" Width="1" Height="22" Background="{DynamicResource BorderSubtleBrush}">
                        <Separator.Template>
                            <ControlTemplate TargetType="Separator">
                                <Border Width="1" Background="{TemplateBinding Background}" />
                            </ControlTemplate>
                        </Separator.Template>
                    </Separator>

                    <Button Style="{StaticResource ModernButtonStyle}" Content="⏮" Command="{Binding FirstPageCommand}" ToolTip="{DynamicResource Loc_FirstPageTooltip}" Margin="2,0" Padding="7,4" />
                    <Button Style="{StaticResource ModernButtonStyle}" Content="◀" Command="{Binding PreviousPageCommand}" ToolTip="{DynamicResource Loc_PrevPageTooltip}" Margin="2,0" Padding="7,4" />

                    <TextBox Width="50"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding ActiveTab.PageJumpInput, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Margin="3,0"
                             Padding="2,3"
                             KeyDown="PageJumpTextBox_KeyDown" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ActiveTab.TotalPages, StringFormat='/ {0}'}"
                               VerticalAlignment="Center"
                               Margin="3,0,6,0"
                               FontWeight="SemiBold" />

                    <Button Style="{StaticResource ModernButtonStyle}" Content="▶" Command="{Binding NextPageCommand}" ToolTip="{DynamicResource Loc_NextPageTooltip}" Margin="2,0" Padding="7,4" />
                    <Button Style="{StaticResource ModernButtonStyle}" Content="⏭" Command="{Binding LastPageCommand}" ToolTip="{DynamicResource Loc_LastPageTooltip}" Margin="2,0,10,0" Padding="7,4" />

                    <Button Style="{StaticResource ModernButtonStyle}" Content="🔍-" Command="{Binding ZoomOutCommand}" ToolTip="{DynamicResource Loc_ZoomOutTooltip}" Margin="2,0" Padding="7,4" />
                    <ComboBox ItemsSource="{Binding ZoomPresets}"
                              SelectedItem="{Binding SelectedZoomPreset}"
                              DisplayMemberPath="Label"
                              SelectedIndex="0"
                              Width="122"
                              Margin="2,0"
                              VerticalAlignment="Center"
                              ToolTip="{DynamicResource Loc_ZoomModeTooltip}" />
                    <Button Style="{StaticResource ModernButtonStyle}" Content="🔍+" Command="{Binding ZoomInCommand}" ToolTip="{DynamicResource Loc_ZoomInTooltip}" Margin="2,0,6,0" Padding="7,4" />
                </StackPanel>

                <!-- Центральна зона (*): Поле пошуку по документу (займає весь вільний простір без накладання) -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        MinWidth="80"
                        Height="34"
                        Margin="8,0"
                        Padding="8,2"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        IsEnabled="{Binding CanSelectText}"
                        ToolTip="{Binding SearchBoxToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBox x:Name="DocumentSearchTextBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanSelectText}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     BorderThickness="0"
                                     Padding="2,2,6,2"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center"
                                     KeyDown="DocumentSearchTextBox_KeyDown" />
                            <TextBlock Text="{DynamicResource Loc_SearchPlaceholder}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="4,0,6,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Margin="6,0,6,0"><Run Text="{Binding SearchCurrentMatchIndex, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding SearchTotalMatches, Mode=OneWay}" /></TextBlock>

                        <Button Grid.Column="2"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="▲"
                                ToolTip="{DynamicResource Loc_SearchPrevTooltip}"
                                Command="{Binding PreviousSearchMatchCommand}"
                                Width="24"
                                Height="24"
                                MinHeight="24"
                                Padding="0"
                                FontSize="10"
                                Margin="1,0" />
                        <Button Grid.Column="3"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="▼"
                                ToolTip="{DynamicResource Loc_SearchNextTooltip}"
                                Command="{Binding NextSearchMatchCommand}"
                                Width="24"
                                Height="24"
                                MinHeight="24"
                                Padding="0"
                                FontSize="10"
                                Margin="1,0" />
                        <Button Grid.Column="4"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="✕"
                                ToolTip="{DynamicResource Loc_SearchClearTooltip}"
                                Command="{Binding ClearSearchCommand}"
                                Width="24"
                                Height="24"
                                MinHeight="24"
                                Padding="0"
                                FontSize="10.5"
                                Margin="2,0,0,0" />
                    </Grid>
                </Border>

                <!-- Права зона (Auto) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- SplitButton «Відкрити ▼» (Діалог вибору файлу + Випадаюче меню останніх відкритих документів) -->
                    <Border x:Name="OpenFileSplitButtonContainer"
                            CornerRadius="6"
                            Margin="4,0"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ContextMenu>
                            <ContextMenu x:Name="RecentFilesDropDownMenu"
                                         Placement="Bottom"
                                         Opened="RecentFilesDropDownMenu_Opened" />
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenFileMainButton"
                                    Grid.Column="0"
                                    Style="{StaticResource SplitButtonMainPartStyle}"
                                    Content="📂"
                                    Padding="9,4"
                                    FontSize="13.5"
                                    ToolTip="{DynamicResource Loc_OpenFileTooltip}"
                                    Command="{Binding OpenAnotherFileInTabCommand}" />
                            <Border Grid.Column="1"
                                    Width="1"
                                    Margin="0,5"
                                    Background="{DynamicResource BorderSubtleBrush}" />
                            <Button x:Name="OpenFileDropDownButton"
                                    Grid.Column="2"
                                    Style="{StaticResource SplitButtonArrowPartStyle}"
                                    Content="▼"
                                    ToolTip="{DynamicResource Loc_OpenRecentDropdownTooltip}"
                                    Click="OpenFileDropDownButton_Click" />
                        </Grid>
                    </Border>
                    <ToggleButton Style="{StaticResource ModernToggleButtonStyle}"
                                  Content="{DynamicResource Loc_SmartPdfFilterBtn}"
                                  IsChecked="{Binding IsSmartPdfColorFilterEnabled, Mode=TwoWay}"
                                  Visibility="{Binding ActiveTab.IsPdfMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ToolTip="{DynamicResource Loc_SmartPdfFilterTooltip}"
                                  Margin="4,0" />
                    <ToggleButton Style="{StaticResource ModernToggleButtonStyle}"
                                  Content="{DynamicResource Loc_SelectionBtn}"
                                  IsChecked="{Binding IsTextSelectionMode, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelectText}"
                                  ToolTip="{Binding TextSelectionToolTip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  Margin="4,0" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Width="34"
                            Padding="0"
                            ToolTip="{DynamicResource Loc_BookmarkTooltip}"
                            Command="{Binding AddQuickBookmarkCommand}"
                            Margin="4,0">
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 5,5.5 C 5,3.57 6.57,2 8.5,2 L 15.5,2 C 17.43,2 19,3.57 19,5.5 L 19,19.8 C 19,21.1 17.5,21.85 16.45,21.05 L 12,17.6 L 7.55,21.05 C 6.5,21.85 5,21.1 5,19.8 Z M 12,6.5 L 12,12.5 M 9,9.5 L 15,9.5"
                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Content="🖨"
                            Width="34"
                            Padding="0"
                            FontSize="14"
                            ToolTip="{DynamicResource Loc_PrintTooltip}"
                            Command="{Binding PrintCurrentPageCommand}"
                            Margin="4,0" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Content="⛶"
                            Width="34"
                            Padding="0"
                            FontSize="14.5"
                            ToolTip="{DynamicResource Loc_FullScreenTooltip}"
                            Command="{Binding ToggleFullScreenCommand}"
                            Margin="4,0" />
                    <ToggleButton Style="{StaticResource ModernToggleButtonStyle}"
                                  Content="{DynamicResource Loc_ReaderNotesBtn}"
                                  IsChecked="{Binding IsAnnotationsVisible, Mode=TwoWay}"
                                  ToolTip="{DynamicResource Loc_ReaderNotesTooltip}"
                                  Margin="4,0,0,0"
                                  Padding="10,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2A: Standalone Start Screen (When launched with no arguments or all tabs closed) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource ReaderViewportBgBrush}"
                      Visibility="{Binding IsStartScreenVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid MaxWidth="860" Margin="32,28" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel>
                    <!-- Hero & Drag-and-Drop Card -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="36,32"
                            Margin="0,0,0,24">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📖 AllReaderBook (Public Beta)"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Loc_StartHeroSubtitle}"
                                       FontSize="13.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,20" />

                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Content="{DynamicResource Loc_StartOpenFileBtn}"
                                    Command="{Binding OpenAnotherFileInTabCommand}"
                                    FontSize="14"
                                    Padding="24,10"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14" />

                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24,14"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_StartDragDropHint}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Recent 10 Opened Files List -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Loc_RecentFilesHeader}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Content="{DynamicResource Loc_ClearHistoryBtn}"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Command="{Binding ClearRecentFilesCommand}"
                                        Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Padding="10,4"
                                        FontSize="11.5" />
                            </Grid>

                            <TextBlock Text="{DynamicResource Loc_EmptyHistoryText}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,8"
                                       Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                            <ItemsControl ItemsSource="{Binding RecentFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type services:RecentReaderFileEntry}">
                                        <Border Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="6"
                                                        Height="34"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding FormatBadge}"
                                                               Foreground="#FFFFFF"
                                                               FontWeight="Bold"
                                                               FontSize="11.5"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding FilePath}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding ProgressSummary}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding LastOpenedDisplay}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource AccentButtonStyle}"
                                                            Content="{DynamicResource Loc_ReadBtn}"
                                                            Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="12,5"
                                                            Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ModernButtonStyle}"
                                                            Content="✕"
                                                            ToolTip="{DynamicResource Loc_RemoveFromListTooltip}"
                                                            Command="{Binding DataContext.RemoveRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,5" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 2B: Main Workspace when Tabs are Open -->
        <Grid Grid.Row="2"
              Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocSidebarColumn" Width="285" MinWidth="180" MaxWidth="500" />
                <ColumnDefinition x:Name="TocSplitterColumn" Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="NotesSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="NotesSidebarColumn" Width="320" MinWidth="200" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- Col 0: Left TOC Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsTocVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="{DynamicResource Loc_TocHeader}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="◀"
                                    HorizontalAlignment="Right"
                                    Padding="6,2"
                                    FontSize="10.5"
                                    ToolTip="{DynamicResource Loc_CollapseTocTooltip}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding ToggleTocCommand}" />
                        </Grid>
                    </Border>
                    <TreeView x:Name="TocTreeView"
                              ItemsSource="{Binding ActiveTab.TableOfContents}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="6"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="TocTreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <ToggleButton x:Name="Expander"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                              ClickMode="Press"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Focusable" Value="False" />
                                                            <Setter Property="Width" Value="16" />
                                                            <Setter Property="Height" Value="16" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" Width="16" Height="16">
                                                                            <Path x:Name="ExpandPath"
                                                                                  Fill="Transparent"
                                                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                                                  StrokeThickness="1.5"
                                                                                  Data="M 4,2 L 9,7 L 4,12"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <RotateTransform Angle="90" CenterX="6.5" CenterY="7" />
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Border x:Name="Bd"
                                                        Grid.Column="1"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,2"
                                                        CornerRadius="5">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Grid.Column="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True" />
                                                        <Condition Property="IsSelectionActive" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:TocItem}" ItemsSource="{Binding Children}">
                                <Border x:Name="TocItemBorder"
                                        Margin="0"
                                        Padding="2,2"
                                        CornerRadius="5"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="TocItemRow_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TocTitleText"
                                                   Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="TocPageBadge"
                                                Grid.Column="1"
                                                Background="{DynamicResource BgCardBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="TocPageText"
                                                       Text="{Binding PageNumber}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                        <Setter TargetName="TocTitleText" Property="Foreground" Value="#FFFFFF" />
                                        <Setter TargetName="TocTitleText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="TocPageBadge" Property="Background" Value="#38000000" />
                                        <Setter TargetName="TocPageText" Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Col 1: TOC GridSplitter -->
            <GridSplitter x:Name="TocGridSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtleBrush}"
                          ShowsPreview="False"
                          Visibility="{Binding IsTocVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Col 2: Center Reader Area -->
            <Grid Grid.Column="2" Background="{DynamicResource ReaderViewportBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PrimaryViewportHost"
                      Grid.Column="0"
                      Background="Transparent"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      DataContext="{Binding ActiveTab}"
                      PreviewMouseLeftButtonDown="ReadingViewport_PreviewMouseLeftButtonDown"
                      MouseLeftButtonDown="ReadingViewport_MouseLeftButtonDown"
                      SizeChanged="PrimaryViewportHost_SizeChanged">

                    <!-- PDF Viewport -->
                    <Grid Visibility="{Binding IsPdfMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer x:Name="PdfScrollViewer"
                                      Focusable="True"
                                      FocusVisualStyle="{x:Null}"
                                      Visibility="{Binding IsContinuousVerticalMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                      HorizontalScrollBarVisibility="{Binding HorizontalScrollVisibility}"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel"
                                      ScrollChanged="PagedScrollViewer_ScrollChanged">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14">
                                <!-- Single Page -->
                                <Border Visibility="{Binding IsSinglePageMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{DynamicResource ReaderPageBgBrush}"
                                        CornerRadius="2">
                                    <Grid>
                                        <Image Source="{Binding CurrentPageImage}"
                                               Width="{Binding ComputedPageDisplayWidth}"
                                               Stretch="Uniform"
                                               SizeChanged="PdfPageImage_SizeChanged"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Canvas Tag="{Binding CurrentPage}"
                                                IsHitTestVisible="False"
                                                Loaded="PdfSearchHighlightCanvas_Loaded"
                                                Unloaded="PdfSearchHighlightCanvas_Unloaded"
                                                SizeChanged="PdfSearchHighlightCanvas_SizeChanged" />
                                        <Canvas Background="#01000000"
                                                Tag="{Binding CurrentPage}"
                                                Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                                IsHitTestVisible="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                MouseLeftButtonDown="PdfSelectionOverlay_MouseLeftButtonDown"
                                                MouseMove="PdfSelectionOverlay_MouseMove"
                                                MouseLeftButtonUp="PdfSelectionOverlay_MouseLeftButtonUp">
                                            <Border Background="#383B82F6"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="2"
                                                    Visibility="Collapsed" />
                                        </Canvas>
                                        <!-- Sticky-Note Bookmark Overlay on Single Page -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,20,20,0"
                                                Width="{Binding StickyBookmarkWidth}"
                                                MinHeight="50"
                                                CornerRadius="6"
                                                Visibility="{Binding CurrentPageBookmark, Converter={StaticResource NullToVisibilityConverter}}"
                                                BorderThickness="2"
                                                BorderBrush="{Binding CurrentPageBookmark.StickyBorderColorHex}"
                                                Background="{Binding CurrentPageBookmark.StickyBgColorHex}"
                                                Padding="10,8"
                                                ToolTip="Закладка на сторінці">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CurrentPageBookmark.QuoteText}"
                                                           FontStyle="Italic"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding CurrentPageBookmark}"
                                                        Style="{StaticResource ModernButtonStyle}"
                                                        Padding="5,1"
                                                        MinHeight="20"
                                                        MinWidth="20"
                                                        FontSize="10"
                                                        VerticalAlignment="Top"
                                                        Margin="6,0,0,0"
                                                        Opacity="0.8"
                                                        ToolTip="Видалити закладку" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Two-Page Spread -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsTwoPageSpreadMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Background="{DynamicResource ReaderPageBgBrush}" Margin="0,0,12,0" CornerRadius="2">
                                        <Grid>
                                            <Image Source="{Binding CurrentPageImage}"
                                                   Width="{Binding ComputedSpreadPageDisplayWidth}"
                                                   Stretch="Uniform"
                                                   SizeChanged="PdfPageImage_SizeChanged"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Canvas Tag="{Binding CurrentPage}"
                                                    IsHitTestVisible="False"
                                                    Loaded="PdfSearchHighlightCanvas_Loaded"
                                                    Unloaded="PdfSearchHighlightCanvas_Unloaded"
                                                    SizeChanged="PdfSearchHighlightCanvas_SizeChanged" />
                                            <Canvas Background="#01000000"
                                                    Tag="{Binding CurrentPage}"
                                                    Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                                    IsHitTestVisible="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    MouseLeftButtonDown="PdfSelectionOverlay_MouseLeftButtonDown"
                                                    MouseMove="PdfSelectionOverlay_MouseMove"
                                                    MouseLeftButtonUp="PdfSelectionOverlay_MouseLeftButtonUp">
                                                <Border Background="#383B82F6"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="2"
                                                        Visibility="Collapsed" />
                                            </Canvas>
                                            <!-- Sticky-Note Bookmark Overlay on Spread Left Page -->
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,20,16,0"
                                                    Width="{Binding StickySpreadBookmarkWidth}"
                                                    MinHeight="50"
                                                    CornerRadius="6"
                                                    Visibility="{Binding CurrentPageBookmark, Converter={StaticResource NullToVisibilityConverter}}"
                                                    BorderThickness="2"
                                                    BorderBrush="{Binding CurrentPageBookmark.StickyBorderColorHex}"
                                                    Background="{Binding CurrentPageBookmark.StickyBgColorHex}"
                                                    Padding="10,8"
                                                    ToolTip="Закладка на сторінці">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding CurrentPageBookmark.QuoteText}"
                                                               FontStyle="Italic"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="✕"
                                                            Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding CurrentPageBookmark}"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Padding="5,1"
                                                            MinHeight="20"
                                                            MinWidth="20"
                                                            FontSize="10"
                                                            VerticalAlignment="Top"
                                                            Margin="6,0,0,0"
                                                            Opacity="0.8"
                                                            ToolTip="Видалити закладку" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource ReaderPageBgBrush}" CornerRadius="2">
                                        <Grid>
                                            <Image Source="{Binding SecondSpreadPageImage}"
                                                   Width="{Binding ComputedSpreadPageDisplayWidth}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Canvas Background="#01000000"
                                                    Tag="{Binding CurrentPage}"
                                                    Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                                    IsHitTestVisible="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    MouseLeftButtonDown="PdfSelectionOverlay_MouseLeftButtonDown"
                                                    MouseMove="PdfSelectionOverlay_MouseMove"
                                                    MouseLeftButtonUp="PdfSelectionOverlay_MouseLeftButtonUp">
                                                <Border Background="#383B82F6"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="2"
                                                        Visibility="Collapsed" />
                                            </Canvas>
                                            <!-- Sticky-Note Bookmark Overlay on Spread Right Page -->
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,20,16,0"
                                                    Width="{Binding StickySpreadBookmarkWidth}"
                                                    MinHeight="50"
                                                    CornerRadius="6"
                                                    Visibility="{Binding SecondSpreadPageBookmark, Converter={StaticResource NullToVisibilityConverter}}"
                                                    BorderThickness="2"
                                                    BorderBrush="{Binding SecondSpreadPageBookmark.StickyBorderColorHex}"
                                                    Background="{Binding SecondSpreadPageBookmark.StickyBgColorHex}"
                                                    Padding="10,8"
                                                    ToolTip="Закладка на сторінці">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding SecondSpreadPageBookmark.QuoteText}"
                                                               FontStyle="Italic"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="✕"
                                                            Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding SecondSpreadPageBookmark}"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Padding="5,1"
                                                            MinHeight="20"
                                                            MinWidth="20"
                                                            FontSize="10"
                                                            VerticalAlignment="Top"
                                                            Margin="6,0,0,0"
                                                            Opacity="0.8"
                                                            ToolTip="Видалити закладку" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Unrestricted Full-Height Virtualized Continuous PDF Scroll (All TotalPages) -->
                        <ListBox x:Name="PdfContinuousListBox"
                                 Focusable="True"
                                 FocusVisualStyle="{x:Null}"
                                 ItemsSource="{Binding ContinuousWindowPages}"
                                 Visibility="{Binding IsContinuousVerticalMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Standard"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1,1"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 ScrollViewer.ScrollChanged="ContinuousListBox_ScrollChanged"
                                 PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ContinuousPageViewModel}">
                                    <Border Width="{Binding DataContext.ComputedPageDisplayWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Height="{Binding DataContext.ContinuousPageItemHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Background="{DynamicResource ReaderPageBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Image Source="{Binding PageBitmap}"
                                                   Stretch="Uniform"
                                                   SizeChanged="PdfPageImage_SizeChanged">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowResPreview}" Value="True">
                                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="Linear" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <!-- Search Match Highlight Overlay Layer -->
                                            <Canvas Tag="{Binding PageNumber}"
                                                    IsHitTestVisible="False"
                                                    Loaded="PdfSearchHighlightCanvas_Loaded"
                                                    Unloaded="PdfSearchHighlightCanvas_Unloaded"
                                                    SizeChanged="PdfSearchHighlightCanvas_SizeChanged" />
                                            <!-- Interactive One-Shot PDF Rectangle Text Selection Layer -->
                                            <Canvas Background="#01000000"
                                                    Tag="{Binding PageNumber}"
                                                    Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                                    IsHitTestVisible="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    MouseLeftButtonDown="PdfSelectionOverlay_MouseLeftButtonDown"
                                                    MouseMove="PdfSelectionOverlay_MouseMove"
                                                    MouseLeftButtonUp="PdfSelectionOverlay_MouseLeftButtonUp">
                                                <Border Background="#383B82F6"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="2"
                                                        Visibility="Collapsed" />
                                            </Canvas>
                                            <TextBlock Text="{Binding PageNumber, StringFormat='Сторінка {0}'}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Background="{DynamicResource BgCardBrush}"
                                                       Padding="6,2"
                                                       FontSize="10.5" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Text / EPUB / FB2 / DOCX / MD Viewport -->
                    <Grid Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer x:Name="TextScrollViewer"
                                      Focusable="True"
                                      FocusVisualStyle="{x:Null}"
                                      Visibility="{Binding IsContinuousVerticalMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="{Binding HorizontalScrollVisibility}"
                                      PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel"
                                      ScrollChanged="PagedScrollViewer_ScrollChanged">
                            <Grid HorizontalAlignment="Center" Margin="14">
                                <Border Width="{Binding ComputedPageDisplayWidth}"
                                        Visibility="{Binding IsSinglePageMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{DynamicResource ReaderPageBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="36,30">
                                    <TextBox x:Name="ReaderTextBox"
                                             Text="{Binding CurrentPageText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="{DynamicResource ReaderPageTextBrush}"
                                             BorderThickness="0"
                                             TextWrapping="Wrap"
                                             FontSize="{Binding TextFontSize}"
                                             FontFamily="Georgia, Segoe UI"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             SelectionOpacity="0.4"
                                             Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                             SelectionChanged="ReaderTextBox_SelectionChanged"
                                             PreviewMouseLeftButtonUp="ReaderTextBox_PreviewMouseLeftButtonUp" />
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsTwoPageSpreadMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Width="{Binding ComputedSpreadPageDisplayWidth}"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ReaderPageBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="28,24">
                                        <TextBox Text="{Binding CurrentPageText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource ReaderPageTextBrush}"
                                                 BorderThickness="0"
                                                 TextWrapping="Wrap"
                                                 FontSize="{Binding TextFontSize}"
                                                 FontFamily="Georgia, Segoe UI"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 SelectionOpacity="0.4"
                                                 Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                                 SelectionChanged="ReaderTextBox_SelectionChanged"
                                                 PreviewMouseLeftButtonUp="ReaderTextBox_PreviewMouseLeftButtonUp" />
                                    </Border>
                                    <Border Width="{Binding ComputedSpreadPageDisplayWidth}"
                                            Background="{DynamicResource ReaderPageBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="28,24">
                                        <TextBox Text="{Binding SecondSpreadPageText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource ReaderPageTextBrush}"
                                                 BorderThickness="0"
                                                 TextWrapping="Wrap"
                                                 FontSize="{Binding TextFontSize}"
                                                 FontFamily="Georgia, Segoe UI"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 SelectionOpacity="0.4"
                                                 Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                                 SelectionChanged="ReaderTextBox_SelectionChanged"
                                                 PreviewMouseLeftButtonUp="ReaderTextBox_PreviewMouseLeftButtonUp" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <ListBox x:Name="TextContinuousListBox"
                                 Focusable="True"
                                 FocusVisualStyle="{x:Null}"
                                 ItemsSource="{Binding ContinuousWindowPages}"
                                 Visibility="{Binding IsContinuousVerticalMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Standard"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.ScrollChanged="ContinuousListBox_ScrollChanged"
                                 PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ContinuousPageViewModel}">
                                    <Border Width="{Binding DataContext.ComputedPageDisplayWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Height="{Binding DataContext.ContinuousPageItemHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Background="{DynamicResource ReaderPageBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="24,18"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <TextBox Text="{Binding PageText, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource ReaderPageTextBrush}"
                                                     FontSize="{Binding DataContext.TextFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     FontFamily="Georgia, Segoe UI"
                                                     TextWrapping="Wrap"
                                                     VerticalAlignment="Top"
                                                     SelectionBrush="{DynamicResource AccentBrush}"
                                                     SelectionOpacity="0.4"
                                                     Cursor="{Binding DataContext.IsTextSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCursorConverter}}"
                                                     SelectionChanged="ReaderTextBox_SelectionChanged"
                                                     PreviewMouseLeftButtonUp="ReaderTextBox_PreviewMouseLeftButtonUp" />
                                            <TextBlock Text="{Binding PageNumber, StringFormat='Сторінка {0}'}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Background="{DynamicResource ReaderPageBgBrush}"
                                                       Padding="5,2"
                                                       FontSize="10" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- БЛОК 1. Індикатор завантаження документа (Progress Overlay) -->
                    <Border Background="#C80D1117"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Panel.ZIndex="50">
                        <Border Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="28,22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding LoadingStatusCaption}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="{Binding LoadingOverlayBarWidth}"
                                           Margin="0,0,0,10" />
                                <Border Width="{Binding LoadingOverlayBarWidth}"
                                        Height="12"
                                        Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ClipToBounds="True">
                                    <Border Width="{Binding LoadingFilledBarWidth}"
                                            Height="12"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="5" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- Secondary Split-View Panel -->
                <Border Grid.Column="1"
                        Width="520"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="2,0,0,0"
                        Background="{DynamicResource ReaderViewportBgBrush}"
                        Visibility="{Binding IsSplitViewEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondaryBrush}" Padding="10,6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="{DynamicResource Loc_SplitViewHeader}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding OpenTabs}"
                                          SelectedItem="{Binding SecondarySplitTab}"
                                          DisplayMemberPath="TabTitle"
                                          Width="240"
                                          HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" DataContext="{Binding SecondarySplitTab}">
                            <Grid Margin="14">
                                <Image Source="{Binding CurrentPageImage}"
                                       Visibility="{Binding IsPdfMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Stretch="Uniform" />
                                <Border Background="{DynamicResource ReaderPageBgBrush}"
                                        Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Padding="24" CornerRadius="6">
                                    <TextBox Text="{Binding CurrentPageText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="{DynamicResource ReaderPageTextBrush}"
                                             BorderThickness="0"
                                             TextWrapping="Wrap"
                                             FontSize="14.5" />
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Col 3: Notes GridSplitter -->
            <GridSplitter x:Name="NotesGridSplitter"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtleBrush}"
                          ShowsPreview="False"
                          Visibility="{Binding IsAnnotationsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Col 4: Right Annotations & Obsidian Export Panel -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="14"
                    Visibility="{Binding IsAnnotationsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Loc_NotesHeader}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_NotesSubheader}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,8" TextWrapping="Wrap" />

                        <TextBlock Text="{DynamicResource Loc_QuoteLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewQuoteInput, UpdateSourceTrigger=PropertyChanged}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />

                        <TextBlock Text="{DynamicResource Loc_CommentLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewCommentInput, UpdateSourceTrigger=PropertyChanged}" Height="46" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Loc_HighlightColorLabel}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Width="22" Height="22" Background="#FACC15" BorderThickness="1" Margin="0,0,5,0" Command="{Binding SetHighlightColorCommand}" CommandParameter="#FACC15" />
                            <Button Width="22" Height="22" Background="#34D399" BorderThickness="1" Margin="0,0,5,0" Command="{Binding SetHighlightColorCommand}" CommandParameter="#34D399" />
                            <Button Width="22" Height="22" Background="#38BDF8" BorderThickness="1" Margin="0,0,5,0" Command="{Binding SetHighlightColorCommand}" CommandParameter="#38BDF8" />
                            <Button Width="22" Height="22" Background="#F472B6" BorderThickness="1" Margin="0,0,5,0" Command="{Binding SetHighlightColorCommand}" CommandParameter="#F472B6" />
                            <Button Width="22" Height="22" Background="#A78BFA" BorderThickness="1" Command="{Binding SetHighlightColorCommand}" CommandParameter="#A78BFA" />
                        </StackPanel>

                        <Button Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource Loc_SaveAnnotationBtn}" Command="{Binding AddHighlightOrNoteCommand}" Margin="0,0,0,6" />
                        <Button Style="{StaticResource ModernButtonStyle}" Content="{DynamicResource Loc_ExportObsidianBtn}" Command="{Binding ExportAnnotationsToObsidianMdCommand}" />
                    </StackPanel>

                    <ListBox x:Name="AnnotationsListBox"
                             ItemsSource="{Binding ActiveTab.Annotations}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="AnnotationsListBox_SelectionChanged"
                             PreviewMouseLeftButtonUp="AnnotationsListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AnnotationRecord}">
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{Binding HighlightColor}"
                                        BorderThickness="4,1,1,1"
                                        CornerRadius="6"
                                        Padding="10,7"
                                        Margin="0,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Cursor="Hand"
                                        ToolTip="{Binding QuoteText}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding PageNumber, StringFormat='🔖 Стор. {0}'}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    HorizontalAlignment="Right"
                                                    Padding="5,0"
                                                    FontSize="10"
                                                    ToolTip="{DynamicResource Loc_DeleteAnnotationTooltip}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Command="{Binding DataContext.DeleteAnnotationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding QuoteText}"
                                                   FontSize="12"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="36"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding CommentText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="32"
                                                   Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CommentText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CommentText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Row 3: Bottom Fast Page Slider & Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ActiveTab.LoadTimeText}"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_FastScrubLabel}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider x:Name="PageSlider"
                            Width="320"
                            Minimum="1"
                            Maximum="{Binding ActiveTab.TotalPages}"
                            Value="{Binding ActiveTab.CurrentPage, Mode=OneWay}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonUp="PageSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="PageSlider_ValueChanged" />
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" MinWidth="68">
                        <TextBlock x:Name="SliderPreviewText"
                                   Text="{Binding ActiveTab.CurrentPage, StringFormat='Стор. {0}'}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveTab.MemoryStatusText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveTab.ReadingProgressPercent, StringFormat='{}{0:0.0}%'}"
                               FontSize="12"
                               FontWeight="Bold"
                               MinWidth="42"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

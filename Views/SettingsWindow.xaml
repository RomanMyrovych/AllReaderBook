<Window x:Class="BookHub.Reader.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BookHub.Core.Models;assembly=BookHub.Core"
        Title="{DynamicResource Loc_SettingsWindowTitle}"
        Width="700" Height="590"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Window Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Loc_SettingsHeader}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource Loc_SettingsSubheader}"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Row 1: Section 1 — Interface Language (Localization) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="{DynamicResource Loc_SettingsLangSectionTitle}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_SettingsLangSectionDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ComboBox x:Name="LanguageComboBox"
                          Grid.Column="1"
                          ItemsSource="{Binding SupportedLanguages}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Width="215"
                          Height="34"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Padding="10,4" />
            </Grid>
        </Border>

        <!-- Row 2: Section 2 — Appearance & Color Themes -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Loc_SettingsThemeSectionTitle}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Loc_SettingsThemeSectionDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <ComboBox x:Name="ThemeComboBox"
                                  Grid.Column="1"
                                  ItemsSource="{Binding ThemeNames}"
                                  SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}"
                                  Width="215"
                                  Height="34"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Padding="10,4" />
                    </Grid>

                    <!-- Dark Themes Grid -->
                    <TextBlock Text="{DynamicResource Loc_SettingsDarkThemesHeader}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,8" />

                    <ItemsControl ItemsSource="{Binding DarkThemes}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ThemePreset}">
                                <Button Margin="0,0,8,0"
                                        Padding="0"
                                        Height="68"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Name}">
                                    <Border CornerRadius="6"
                                            Background="{Binding BgPrimary}"
                                            BorderBrush="{Binding Accent}"
                                            BorderThickness="1.5"
                                            Padding="12,8">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="{Binding TextPrimary}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding BgSecondary}" BorderBrush="{Binding BorderSubtle}" BorderThickness="1" Margin="0,0,4,0" />
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding BgCard}" BorderBrush="{Binding BorderSubtle}" BorderThickness="1" Margin="0,0,4,0" />
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding Accent}" Margin="0,0,4,0" />
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding ReaderPageBg}" BorderBrush="{Binding BorderSubtle}" BorderThickness="1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Light Themes Grid -->
                    <TextBlock Text="{DynamicResource Loc_SettingsLightThemesHeader}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,8" />

                    <ItemsControl ItemsSource="{Binding LightThemes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ThemePreset}">
                                <Button Margin="0,0,8,0"
                                        Padding="0"
                                        Height="68"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Name}">
                                    <Border CornerRadius="6"
                                            Background="{Binding BgPrimary}"
                                            BorderBrush="{Binding Accent}"
                                            BorderThickness="1.5"
                                            Padding="12,8">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="{Binding TextPrimary}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding BgSecondary}" BorderBrush="{Binding BorderSubtle}" BorderThickness="1" Margin="0,0,4,0" />
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding BgCard}" BorderBrush="{Binding BorderSubtle}" BorderThickness="1" Margin="0,0,4,0" />
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding Accent}" Margin="0,0,4,0" />
                                                    <Border Width="18" Height="10" CornerRadius="2" Background="{Binding ReaderPageBg}" BorderBrush="{Binding BorderSubtle}" BorderThickness="1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Row 3: Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource Loc_SettingsSavedHint}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Style="{StaticResource AccentButtonStyle}"
                    Content="{DynamicResource Loc_CloseBtn}"
                    MinWidth="130"
                    Height="36"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>

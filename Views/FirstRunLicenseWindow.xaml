<Window x:Class="BookHub.Reader.Views.FirstRunLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllReaderBook — Ліцензійна угода (Public Beta)"
        Width="740" Height="600"
        MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Background="{DynamicResource AccentBrush}" Width="46" Height="46" CornerRadius="10" Margin="0,0,14,0">
                <TextBlock Text="📜" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="AllReaderBook — Ліцензійна угода (Public Beta)"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Будь ласка, ознайомтеся з умовами ліцензії MIT та гарантіями приватності перед початком роботи"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Row 1: Short AS IS & Privacy Summary Banner -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Важлива інформація про гарантії (AS IS) та приватність"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="• Програма розповсюджується безкоштовно з відкритим кодом на умовах ліцензії MIT за принципом «ЯК Є» («AS IS»), без будь-яких явних чи непрямих гарантій.&#x0a;• AllReaderBook працює на 100% локально (офлайн), не містить телеметрії чи трекерів і не збирає жодних персональних даних."
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Row 2: Scrollable Full MIT License Text -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <TextBox x:Name="LicenseTextBox"
                     IsReadOnly="True"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas, Segoe UI"
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <!-- Row 3: Confirmation CheckBox -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,12,0,14">
            <CheckBox x:Name="AcceptCheckBox"
                      IsChecked="False"
                      VerticalContentAlignment="Center"
                      Cursor="Hand"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Checked="AcceptCheckBox_CheckedChanged"
                      Unchecked="AcceptCheckBox_CheckedChanged">
                <TextBlock Text="Я ознайомився(-лась) з умовами ліцензії MIT і погоджуюся з використанням програми на умовах Public Beta (AS IS)"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="6,0,0,0" />
            </CheckBox>
        </Border>

        <!-- Row 4: Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="DeclineButton"
                    Grid.Column="0"
                    Style="{StaticResource ModernButtonStyle}"
                    Content="Відхилити та вийти"
                    MinWidth="170"
                    Height="36"
                    Padding="16,6"
                    Click="DeclineButton_Click" />

            <Button x:Name="AgreeButton"
                    Grid.Column="2"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Я згоден"
                    IsEnabled="False"
                    MinWidth="170"
                    Height="36"
                    Padding="20,6"
                    Click="AgreeButton_Click" />
        </Grid>
    </Grid>
</Window>
